{
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/chromium",
          "--headless",
          "--isolated",
          "--viewport=1440x900"
        ]
      }
    }
  }
}
