# ---------------------------------------------------------------------------
# Bringo Money Flow — environment template
#
# Copy to `.env.local` for the Vite frontend.
# Convex deployment secrets are NOT read from `.env.local`; set them with:
#   npx convex env set KEY value
# (or through the Convex dashboard → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# --- Frontend (Vite) -------------------------------------------------------
# Local Convex dev deployment, printed by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Cloud URL used by the React client.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# HTTP actions / auth site URL.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Convex Auth (set on the deployment) -----------------------------------
# Generate with:
#   npx @convex-dev/auth --web-server-url http://localhost:5173
# or create the key pair manually with `jose` (see Docs/TASKS_M1.md).
JWT_PRIVATE_KEY=
JWKS=

# Allowed frontend origin for auth callbacks. Production must use the real URL.
SITE_URL=http://localhost:5173

# --- Gmail import (Milestone 3; set on the deployment) ----------------------
# Google Cloud OAuth 2.0 client with Gmail readonly/modify scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
